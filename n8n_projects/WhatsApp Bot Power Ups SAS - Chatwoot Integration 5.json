    {
      "parameters": {
        "jsCode": "// Accedemos al cuerpo del webhook original\nconst data = items[0].json.body; \n\n// 1. Extraer nombre (Buscamos en varias rutas por seguridad)\nconst senderName = data.sender?.name || data.meta?.sender?.name || \"Votante Desconocido\";\n\n// 2. Extraer número de teléfono y limpiar caracteres no numéricos\nlet rawPhone = data.sender?.phone_number || data.meta?.sender?.phone_number || data.contact_inbox?.source_id || \"\";\nconst phoneNumber = rawPhone.replace(/\\D/g, ''); \n\n// 3. Extraer contenido del mensaje\nconst messageText = data.content || (data.messages && data.messages[0]?.content) || \"\";\n\n// --- AJUSTE DE PUNTEROS PARA EL FILTRO HUMANO ---\n// Extraemos los valores de control para que el nodo 'If' los vea fácilmente\nconst messageType = data.message_type || \"\";\nconst assigneeId = data.conversation?.assignee_id || data.assignee_id || null;\n\nreturn [{\n  json: {\n    senderName: senderName,\n    phoneNumber: phoneNumber, \n    messageText: messageText,\n    // Nuevos campos para el Filtro Humano\n    messageType: messageType,\n    assigneeId: assigneeId,\n    // Datos de seguimiento\n    conversationId: data.conversation?.id || data.id || \"N/A\",\n    receivedAt: new Date().toISOString(),\n    status: data.conversation?.status || data.status || \"open\"\n  }\n}];"
      },
      "id": "2c825a97-0ca7-452e-8832-e3694d772f1c",
      "name": "Procesar Webhook Chatwoot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -4112,
        2880
      ]
    },
